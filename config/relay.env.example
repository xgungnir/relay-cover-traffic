# Network interface that every cover sender socket binds to with iperf3 --bind-dev.
EGRESS_DEV="eth0"

# Comma-separated cover receiver targets. Each entry must be host:port or [ipv6]:port.
COVER_TARGETS="receiver1.example.com:11222, [2001:db8::20]:11222"

# Single source of truth for normal rate, busy threshold, and busy-rate derivation.
COVER_RATE="2M"

# Random total cover-traffic window per hour, shared across all targets.
COVER_DURATION_RANGE="1200-2400"

# auto, udp, or tcp. auto randomly chooses TCP or UDP before each segment.
COVER_TYPE="auto"
