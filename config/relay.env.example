# Network interface on this relay node.
EGRESS_DEV="eth0"

# Main relay remote targets for QoS classification only.
# Must match the effective remote endpoints configured manually in /etc/sing-box/config.json.
RELAY_QOS_TARGETS="relay-backend.example.com:8443, 1.2.3.4:8443, [2001:db8::10]:8443"

# Cover traffic receiver targets. Comma-separated host:port values.
COVER_TARGETS="receiver1.example.com:11222, 1.2.3.4:11222, [2001:db8::20]:11222"

# Cover traffic rate.
COVER_RATE="5M"

# auto, udp, or tcp. In auto mode, each iperf3 process randomly uses UDP or TCP.
COVER_TYPE="auto"

# Random total cover traffic running duration per hour, shared across all COVER_TARGETS.
COVER_MIN_SECONDS="1200"
COVER_MAX_SECONDS="2400"

# Retry and segmentation for iperf3 sender.
COVER_RETRY_DELAY_SECONDS="5"
COVER_MAX_SEGMENT_SECONDS="300"

# Allow cover traffic above 5 Mbps only when explicitly true.
ALLOW_COVER_RATE_ABOVE_5M="false"

# Total safe relay egress shaping rate.
TC_TOTAL_RATE="30mbit"

# Main relay QoS class.
TC_RELAY_RATE="25mbit"
TC_RELAY_CEIL="30mbit"

# Cover traffic QoS class.
TC_COVER_RATE="64kbit"
TC_COVER_CEIL="5mbit"

# Default QoS class.
TC_DEFAULT_RATE="1mbit"
TC_DEFAULT_CEIL="30mbit"
