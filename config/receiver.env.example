# Allowed relay node source addresses for cover traffic.
# Entries can be spaces or commas. CIDR is allowed for firewall rules.
COVER_SOURCE_WHITELIST_V4="5.6.7.8, 5.6.7.9"
COVER_SOURCE_WHITELIST_V6=""

# Receiver iperf3 port for cover traffic.
COVER_RECEIVER_PORT="11222"

# Optional bind address overrides.
# Leave empty to auto-detect non-WARP, non-loopback global addresses on UP interfaces.
COVER_BIND_ADDRESS_V4=""
COVER_BIND_ADDRESS_V6=""

# Restart an idle iperf3 server internally after this many seconds.
COVER_RECEIVER_IDLE_TIMEOUT_SECONDS="300"

# Detect receiver processes stuck on abandoned control connections.
COVER_RECEIVER_WATCHDOG_ENABLED="true"
COVER_RECEIVER_WATCHDOG_INTERVAL_SECONDS="60"
COVER_RECEIVER_STUCK_CONFIRM_SECONDS="10"
COVER_RECEIVER_STUCK_CONNECTION_THRESHOLD="1"

# Existing sing-box service port, for operator reference only.
# Firewall script must not block this port.
SING_BOX_SERVICE_PORT="8443"

# nftables, iptables-legacy, or auto.
FIREWALL_BACKEND="auto"
