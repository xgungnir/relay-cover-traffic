# Allowed relay node source addresses for cover traffic.
# Entries can be spaces or commas. IPs, CIDRs, and DNS names are allowed.
# DNS names in the IPv4 variable resolve only A records; DNS names in the IPv6
# variable resolve only AAAA records. Receiver firewall rules refresh every
# 30 minutes after install.
COVER_SOURCE_WHITELIST_V4="5.6.7.8, dynamic-relay.example.com"
COVER_SOURCE_WHITELIST_V6=""

# Receiver iperf3 port for cover traffic.
COVER_RECEIVER_PORT="11222"

# Optional bind address overrides.
# Leave empty to auto-detect non-WARP, non-loopback global addresses on UP interfaces.
COVER_BIND_ADDRESS_V4=""
COVER_BIND_ADDRESS_V6=""

# nftables, iptables-legacy, or auto.
FIREWALL_BACKEND="auto"
